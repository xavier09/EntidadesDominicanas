<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <title>Superintendencia de Bancos</title>
</head>
<body>
    <div class="containerC">
        <aside class="sidebar">
            <div class="logo">
                <img width="200" height="100" src="data:image/png;base64, " alt="Red dot" />
            </div>
            <nav>
                <ul>
                    <li>
                        <span><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" id="Group_5401" data-name="Group 5401" width="24" height="24" viewBox="0 0 24 24"><defs><clipPath id="clip-path"><rect id="Rectangle_1726" data-name="Rectangle 1726" width="24" height="24" fill="#d9480f" /></clipPath></defs><g id="Mask_Group_958" data-name="Mask Group 958" clip-path="url(#clip-path)"><path id="home_24" data-name="home 24" d="M12.985,3.118a2.769,2.769,0,0,1,3.572,0l8.309,7.01a2.769,2.769,0,0,1,.984,2.117V24.311A2.154,2.154,0,0,1,23.7,26.465H20a2.154,2.154,0,0,1-2.154-2.154V18.157a.923.923,0,0,0-.923-.923H12.617a.923.923,0,0,0-.923.923v6.155A2.154,2.154,0,0,1,9.54,26.465H5.847a2.154,2.154,0,0,1-2.154-2.154V12.245a2.77,2.77,0,0,1,.984-2.117Z" transform="translate(-2.771 -2.465)" fill="#d9480f" /></g></svg></span>
                        <a asp-controller="Home" asp-action="Index">Inicio</a>
                    </li>
                    <li><a asp-controller="Home" asp-action="Consulta">Consulta</a></li>
                    <li><a asp-controller="Home" asp-action="CrearRegistro">Crear registro</a></li>
                </ul>
            </nav>
        </aside>
        <div class="main-content">
            <header>
                <h2 class="titulo"> @ViewData["Title"] </h2>
            </header>
            <section class="main-box">
                @RenderBody()
                <!-- Contenido dinámico aquí -->
            </section>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdn.datatables.net/v/dt/jq-3.7.0/dt-2.2.2/datatables.min.css" rel="stylesheet">
    <script src="https://cdn.datatables.net/v/dt/jq-3.7.0/dt-2.2.2/datatables.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

